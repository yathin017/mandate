# Copy to apps/web/.env (gitignored). Nothing here is secret: Vite exposes VITE_* values to the browser.

# Production builds: origin of the indexer API (add this site's origin to the API's API_CORS_ORIGINS).
# Leave unset in development; the dev server proxies /api to MANDATE_API_PROXY.
# VITE_API_URL=https://api.example.com

# Development only: where the dev server proxies /api (default http://127.0.0.1:8787).
# MANDATE_API_PROXY=http://127.0.0.1:8787

# Chain RPC for wallet flows only (Safe approvals, simulations). Default http://127.0.0.1:8547.
# VITE_RPC_URL=http://127.0.0.1:8547
