# Copy to .env (repo root) and fill in. .env is gitignored; never commit real keys.
# Root pnpm scripts load this file; Foundry alone does not, so run tests via `pnpm contracts:test`.

# Archive RPC for chain id 1. Fork tests skip when unset.
# drpc's public endpoint serves archive state; publicnode and flashbots do not (verified Nov 6, 2026).
# The fork block is pinned per chain in config/chains/<chainId>.json.
MAINNET_RPC_URL=https://eth.drpc.org

# Optional: the replay exporter starts its own local Anvil here and refuses an occupied port.
# LOCAL_RPC_URL=http://127.0.0.1:8547

# ---------------------------------------------------------------- indexer (apps/indexer)
# Postgres (source of truth) and Redis (cache only). Defaults match compose.yaml.
DATABASE_URL=postgres://mandate:mandate@127.0.0.1:5432/mandate
REDIS_URL=redis://127.0.0.1:6379
# RPC of the chain being indexed and its runtime chain id (31337 = local mainnet fork demo).
INDEXER_RPC_URL=http://127.0.0.1:8547
INDEXER_CHAIN_ID=31337
# Blocks to wait before treating a block as final. 0 is fine on a local fork; use >= 12 on a live chain.
INDEXER_CONFIRMATIONS=0
INDEXER_POLL_INTERVAL_MS=1000
# Market-maker availability probes: read-only quotes per live strategy and side, every N seconds (0 = off).
# INDEXER_PROBE_INTERVAL_S=600
# API
API_PORT=8787
# Comma-separated browser origins allowed by CORS. Empty = same-origin only.
API_CORS_ORIGINS=http://localhost:5173
# Max simulated attempts per client IP per minute.
API_ATTEMPTS_PER_MINUTE=20
# Sign-in (EIP-4361). Web origins whose users may sign in; empty disables sign-in.
API_AUTH_ORIGINS=http://localhost:5173
# Session cookie: Secure + __Host- prefix. Set false only for plain-http dev hosts (Safari drops Secure cookies on http://localhost).
API_SESSION_COOKIE_SECURE=false
# API_SESSION_TTL_HOURS=168
# API_AUTH_PER_MINUTE=10

# Indexer tests (pnpm indexer:test). The test database is WIPED on every run; never point it at real data.
# INDEXER_TEST_DATABASE_URL=postgres://mandate:mandate@127.0.0.1:5432/mandate_test
# INDEXER_TEST_REDIS_URL=redis://127.0.0.1:6379

# Base mainnet live deployment (contracts/script/live). THROWAWAY keys holding only gas funds; never commit .env.
# BASE_RPC_URL=https://mainnet.base.org
# BASE_DEPLOYER_PRIVATE_KEY=0x...
# The demo roles are fixed in contracts/script/live/LiveConfig.sol and are not read from the environment:
#   Safe Owner 2 0x6a4fb4561051dD5B25619ab997152892008C7bF6, Market Maker 0xbDafcA30260a4a5550cAD1F11928b26f1B063126.
# BASE_MM_PRIVATE_KEY=0x...       (optional: the live market maker, for LiveFills)
# Base stack (pnpm base:worker / base:server / base:web): a keyed RPC (Alchemy/QuickNode/Infura); public ones rate-limit.
# BASE_INDEXER_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# BASE_DATABASE_URL=postgres://mandate:mandate@127.0.0.1:5432/mandate_base
# With a public RPC (e.g. https://base.gateway.tenderly.co, which serves eth_getLogs; mainnet.base.org refuses it),
# slow the Base worker down (defaults: 3000 / 2 / 500):
# BASE_INDEXER_POLL_INTERVAL_MS=15000
# BASE_INDEXER_SNAPSHOT_CONCURRENCY=1
# BASE_INDEXER_LOG_RANGE=500
