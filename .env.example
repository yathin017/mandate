# Copy to .env and fill in. .env is gitignored; never commit real keys.

# RPC used by `anvil --fork-url` and Foundry fork tests (chain id 1).
# A public endpoint works but may rate-limit; an archive RPC is faster.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Block every fork is pinned to, so tests and demos are deterministic.
# Set after verifying Aqua + SwapVM are deployed at this height (see NOTES.md).
MAINNET_FORK_BLOCK=
