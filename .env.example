# Copy to .env (repo root) and fill in. .env is gitignored; never commit real keys.
# Root pnpm scripts load this file; Foundry alone does not, so run tests via `pnpm contracts:test`.

# Archive RPC for chain id 1. Fork tests skip when unset.
# drpc's public endpoint serves archive state; publicnode and flashbots do not (verified Nov 6, 2026).
# The fork block is pinned per chain in config/chains/<chainId>.json.
MAINNET_RPC_URL=https://eth.drpc.org

# Optional: the replay exporter starts its own local Anvil here and refuses an occupied port.
# LOCAL_RPC_URL=http://127.0.0.1:8547
