{
  "name": "mandate",
  "private": true,
  "description": "The market-maker deal as an onchain program (1inch Aqua + SwapVM + Uniswap v4).",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "set -a; [ -f .env ] && . ./.env; set +a; cd contracts && forge test",
    "fork": "set -a; . ./.env; set +a; anvil --fork-url \"$MAINNET_RPC_URL\" --fork-block-number $(jq -r .forkBlock config/chains/1.json)",
    "replay:run": "pnpm packages:build && node --env-file-if-exists=.env replay/export.ts",
    "replay:serve": "pnpm packages:build && node --env-file-if-exists=.env replay/export.ts --keep-alive",
    "replay:test": "pnpm packages:build && node --test replay/replay.test.ts",
    "replay:verify": "node replay/verify.ts",
    "generate": "pnpm contracts:build && cd contracts && RUST_LOG=error forge script script/GenerateSdkFixtures.s.sol:GenerateSdkFixtures --quiet && cd .. && node scripts/generate.ts",
    "generate:check": "pnpm contracts:build && cd contracts && SDK_FIXTURES_CHECK=true RUST_LOG=error forge script script/GenerateSdkFixtures.s.sol:GenerateSdkFixtures --quiet && cd .. && node scripts/generate.ts --check",
    "packages:build": "pnpm generate && tsc -b packages/chains packages/sdk",
    "packages:test": "node --test packages/chains/test/*.test.ts packages/sdk/test/*.test.ts",
    "sdk:test:fork": "pnpm packages:build && node --env-file-if-exists=.env replay/export.ts --test-sdk",
    "packages:typecheck": "tsc -p packages/chains/tsconfig.test.json && tsc -p packages/sdk/tsconfig.test.json",
    "indexer:test": "pnpm --filter @mandate/indexer run test",
    "indexer:typecheck": "tsc -p apps/indexer/tsconfig.json",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "indexer:migrate": "pnpm --filter @mandate/indexer run db:migrate",
    "indexer:worker": "pnpm --filter @mandate/indexer run worker",
    "indexer:server": "pnpm --filter @mandate/indexer run server",
    "web:dev": "pnpm --filter @mandate/web run dev",
    "web:build": "pnpm --filter @mandate/web run build",
    "web:typecheck": "pnpm --filter @mandate/web run typecheck",
    "web:test": "pnpm --filter @mandate/web run test"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
